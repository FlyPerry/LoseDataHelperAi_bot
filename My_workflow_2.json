      "parameters": {
        "jsCode": "let raw = $input.first().json.output;\n\n// Удаляем обёртку ```json и ```\nraw = raw.replace(/^```json\\s*/, '').replace(/```$/, '');\n\nlet message = \"❗ Не удалось обработать рекомендации.\";\n\ntry {\n  // Один парсинг, потому что результат уже объект\n  const data = JSON.parse(raw);\n\n  if (data.recommendations && Array.isArray(data.recommendations)) {\n    const formatted = data.recommendations\n      .map((rec, i) => `${i + 1}. ${rec}`)\n      .join('\\n');\n\n    message = `🛡️ *Рекомендации по безопасности:*\\n\\n${formatted}`;\n  } else if (data.error) {\n    message = `⚠️ ${data.error}`;\n  }\n} catch (err) {\n  message = `❗ Ошибка при парсинге:\\n\\`${err.message}\\``;\n}\n\nreturn {\n  json: {\n    message\n  }\n};\n"
      },
