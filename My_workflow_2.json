    {
      "parameters": {
        "jsCode": "function formatNews(articles) {\n  if (!articles || articles.length === 0) {\n    return \"⚠️ Нет свежих новостей по запросу.\";\n  }\n\n  const result = articles.map((item, index) => {\n    const title = `*${index + 1}. [${item.title}](${item.url})*`;\n    const description = item.description ? `\\n${item.description}` : '';\n    const published = item.publishedAt\n      ? `\\n_Опубликовано: ${new Date(item.publishedAt).toLocaleDateString('ru-RU')}_`\n      : '';\n    const image = item.image ? `\\n[Изображение](${item.image})` : ''; // безопасная ссылка\n    return `${title}${description}${published}${image}`;\n  });\n\n  return `📰 *Последние новости об утечках данных:*\\n\\n${result.join('\\n\\n')}`;\n}\n\ntry {\n  const data = {\n    output: $input.first().json.output\n  };\n\n  const parsedOuter = JSON.parse(data.output);\n  const articlesArray = JSON.parse(parsedOuter.output);\n\n  return {\n    json: {\n      message: formatNews(articlesArray)\n    }\n  };\n} catch (error) {\n  // Если что-то пошло не так — возвращаем \"как есть\"\n  return {\n    json: {\n        message: $input.first().json.output\n    }\n  };\n}\n"
      },
